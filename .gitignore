# Quarto build output
/.quarto/
/_site/
/_freeze/
**/*.quarto_ipynb

# Claude Code per-user settings (keep .claude/settings.json if/when you add shared project config)
.claude/settings.local.json

# Claude Code project-context file — internal notes for AI assistants, not for public repo
CLAUDE.md

# OS / editor noise
.DS_Store
Thumbs.db
__MACOSX/
.idea/
.vscode/
*.swp
*~
*.bak
*.tmp

# Python (we use it for image-processing scripts)
__pycache__/
*.pyc

# Credentials safety net (in case you ever add an .env for an API key, etc.)
.env
.env.local

# Large source/master video files — keep locally for editing, never commit.
# Compressed snippets (a few MB each) in assets/videos/ are fine to commit;
# only the multi-hundred-MB masters are excluded.
assets/videos/moving_cells.mp4

# Local backups of pre-re-encode video sources (safety net before lossy re-encodes).
# Kept locally so we can recover if a re-encode goes wrong; not for the repo.
assets/videos/.orig/

# Gallery originals: drop full-res photos here, run scripts/process_gallery.py,
# committed JPGs (01.jpg, 02.jpg, ...) go into assets/gallery/ at ~1600px.
assets/gallery/_inbox/
